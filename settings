#!/bin/bash
set -euo pipefail

# ─────────────────────────────────────────────────────────────
#  AYUSHTHEWARRIOR SETTINGS
# ─────────────────────────────────────────────────────────────

RESET='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'

BRED='\033[0;91m'
BGREEN='\033[0;92m'
BYELLOW='\033[0;93m'
BBLUE='\033[0;94m'
BPURPLE='\033[0;95m'
BCYAN='\033[0;96m'
BWHITE='\033[0;97m'

display_header() {
    clear
    echo -e "${BOLD}${BCYAN}"
    cat << "EOF"
       __     ___    _  _____ _    _ _______ _    _ ________          __     _____  _____  _____ ____  _____  
     /\\ \   / / |  | |/ ____| |  | |__   __| |  | |  ____\ \        / /\   |  __ \|  __ \|_   _/ __ \|  __ \ 
    /  \\ \_/ /| |  | | (___ | |__| |  | |  | |__| | |__   \ \  /\  / /  \  | |__) | |__) | | || |  | | |__) |
   / /\ \\   / | |  | |\___ \|  __  |  | |  |  __  |  __|   \ \/  \/ / /\ \ |  _  /|  _  /  | || |  | |  _  / 
  / ____ \| |  | |__| |____) | |  | |  | |  | |  | | |____   \  /\  / ____ \| | \ \| | \ \ _| || |__| | | \ \ 
 /_/    \_\_|   \____/|_____/|_|  |_|  |_|  |_|  |_|______|   \/  \/_/    \_\_|  \_\_|  \_\_____\____/|_|  \_\
                                                                                                              
                                                                                                              
EOF
    echo -e "${RESET}"
    echo -e "${BOLD}${BPURPLE}          ╔════════════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}${BPURPLE}          ║${RESET}        ${BOLD}${BWHITE}AYUSHTHEWARRIOR SETTINGS${RESET}        ${BOLD}${BPURPLE}║${RESET}"
    echo -e "${BOLD}${BPURPLE}          ╚════════════════════════════════════════════╝${RESET}"
    echo -e "${DIM}                      Powered by AYUSHTHEWARRIOR${RESET}"
    echo
}

print_status() {
    local type=$1
    local message=$2
    local prefix color

    case $type in
        "INFO")    prefix="[◆ INFO]";    color="${BBLUE}" ;;
        "WARN")    prefix="[⚠ WARN]";    color="${BYELLOW}" ;;
        "ERROR")   prefix="[✖ ERROR]";   color="${BRED}" ;;
        "SUCCESS") prefix="[✔ SUCCESS]"; color="${BGREEN}" ;;
        "INPUT")   prefix="[➤ INPUT]";   color="${BCYAN}" ;;
        "SYSTEM")  prefix="[⚙ SYSTEM]";  color="${BPURPLE}" ;;
        "RUN")     prefix="[▶ RUN]";     color="${BGREEN}" ;;
        *)         prefix="[$type]";     color="${BWHITE}" ;;
    esac

    echo -e "${BOLD}${color}${prefix}${RESET} ${message}"
}

print_box() {
    local title="$1"
    local width=${2:-52}
    echo -e "${BOLD}${BPURPLE}┌$(printf '─%.0s' $(seq 1 $width))┐${RESET}"
    printf "${BOLD}${BPURPLE}│${RESET} ${BOLD}${BWHITE}%-*s${RESET}${BOLD}${BPURPLE}│${RESET}\n" $((width-2)) "$title"
    echo -e "${BOLD}${BPURPLE}└$(printf '─%.0s' $(seq 1 $width))┘${RESET}"
}

# ─────────────────────────────────────────────────────────────
#  ACTIONS
# ─────────────────────────────────────────────────────────────

install_tailscale() {
    print_status "SYSTEM" "Installing ${BOLD}Tailscale${RESET}..."
    echo
    curl -fsSL https://tailscale.com/install.sh | sh
    echo
    print_status "SUCCESS" "Tailscale installed"
    print_status "INFO" "Run ${BOLD}sudo tailscale up${RESET} to connect"
}

install_sshx() {
    print_status "SYSTEM" "Installing ${BOLD}SSHX${RESET}..."
    echo
    curl -sSf https://sshx.io/get | sh
    echo
    print_status "SUCCESS" "SSHX installed"
}

install_cloudflare() {
    print_status "SYSTEM" "Installing ${BOLD}Cloudflared${RESET}..."
    echo

    # Add Cloudflare GPG key
    sudo mkdir -p --mode=0755 /usr/share/keyrings
    curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg | sudo tee /usr/share/keyrings/cloudflare-main.gpg >/dev/null

    # Add repository
    echo 'deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main' | sudo tee /etc/apt/sources.list.d/cloudflared.list

    # Install
    sudo apt-get update && sudo apt-get install -y cloudflared

    echo
    print_status "SUCCESS" "Cloudflared installed successfully"
    echo

    # Ask for token
    print_status "INPUT" "Paste your Cloudflare Tunnel Token below:"
    read -r CF_TOKEN

    if [ -z "$CF_TOKEN" ]; then
        print_status "ERROR" "No token provided. Skipping connection."
        return
    fi

    print_status "SYSTEM" "Connecting Cloudflare Tunnel..."
    sudo cloudflared service install "$CF_TOKEN"

    echo
    print_status "SUCCESS" "Cloudflare Tunnel connected!"
}

run_vps_detection() {
    print_status "SYSTEM" "Running ${BOLD}VPS Detection${RESET}..."
    echo
    print_status "INFO" "Credit: ${BOLD}hopingboyz${RESET}"
    echo
    bash <(curl -fsSL https://raw.githubusercontent.com/hopingboyz/linux/main/detect-server.sh)
}

run_ssh_fixer() {
    print_status "SYSTEM" "Running ${BOLD}SSH Fixer${RESET}..."
    echo
    bash <(curl -fsSL https://raw.githubusercontent.com/officialayushthewarrior-beep/VMOP/refs/heads/main/ssh.sh)
}

# ─────────────────────────────────────────────────────────────
#  MAIN MENU
# ─────────────────────────────────────────────────────────────

main_menu() {
    while true; do
        display_header

        print_box "SETTINGS MENU"
        echo -e "  ${BOLD}${BGREEN}1)${RESET}  Tailscale"
        echo -e "  ${BOLD}${BCYAN}2)${RESET}  SSHX"
        echo -e "  ${BOLD}${BYELLOW}3)${RESET}  Cloudflare          ${DIM}(Install + Connect)${RESET}"
        echo -e "  ${BOLD}${BPURPLE}4)${RESET}  VPS Detection       ${DIM}(by hopingboyz)${RESET}"
        echo -e "  ${BOLD}${BRED}5)${RESET}  SSH Fixer"
        echo -e "  ${BOLD}${BWHITE}0)${RESET}  Exit"
        echo

        read -p "$(print_status "INPUT" "Enter your choice: ")" choice

        case $choice in
            1)
                install_tailscale
                ;;
            2)
                install_sshx
                ;;
            3)
                install_cloudflare
                ;;
            4)
                run_vps_detection
                ;;
            5)
                run_ssh_fixer
                ;;
            0)
                echo
                print_status "SYSTEM" "Shutting down..."
                echo -e "${BOLD}${BPURPLE}          See you later, warrior.${RESET}"
                echo
                exit 0
                ;;
            *)
                print_status "ERROR" "Invalid option"
                sleep 1
                ;;
        esac

        echo
        read -p "$(print_status "INPUT" "Press Enter to return to menu...")"
    done
}

# ─────────────────────────────────────────────────────────────

main_menu
