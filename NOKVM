#  MAIN MENU
# ─────────────────────────────────────────────────────────────

main_menu() {
    while true; do
        display_header

        local vms=($(get_vm_list))
        local vm_count=${#vms[@]}

        if [ $vm_count -gt 0 ]; then
            print_box "ACTIVE VIRTUAL MACHINES · $vm_count FOUND"
            for i in "${!vms[@]}"; do
                local status="${BRED}Stopped${RESET}"
                if is_vm_running "${vms[$i]}"; then
                    status="${BGREEN}Running${RESET}"
                fi
                printf "  ${BOLD}${BCYAN}%2d)${RESET}  %-20s  [%b]\n" $((i+1)) "${vms[$i]}" "$status"
            done
            echo
        else
            print_status "INFO" "No VMs found. Create one to get started."
            echo
        fi

        print_box "MAIN MENU"
        echo -e "  ${BOLD}${BGREEN}1)${RESET}  Create a new VM"
        if [ $vm_count -gt 0 ]; then
            echo -e "  ${BOLD}${BGREEN}2)${RESET}  Start a VM"
            echo -e "  ${BOLD}${BYELLOW}3)${RESET}  Stop a VM"
            echo -e "  ${BOLD}${BCYAN}4)${RESET}  Show VM info"
            echo -e "  ${BOLD}${BPURPLE}5)${RESET}  Edit VM configuration"
            echo -e "  ${BOLD}${BRED}6)${RESET}  Delete a VM"
            echo -e "  ${BOLD}${BYELLOW}7)${RESET}  Resize VM disk"
            echo -e "  ${BOLD}${BCYAN}8)${RESET}  Show VM performance"
        fi
        echo -e "  ${BOLD}${BWHITE}0)${RESET}  Exit"
        echo

        read -p "$(print_status "INPUT" "Enter your choice: ")" choice

        case $choice in
            1) create_new_vm ;;
            2)
                if [ $vm_count -gt 0 ]; then
                    read -p "$(print_status "INPUT" "VM number to start: ")" vm_num
                    if [[ "$vm_num" =~ ^[0-9]+$ ]] && [ "$vm_num" -ge 1 ] && [ "$vm_num" -le $vm_count ]; then
                        start_vm "${vms[$((vm_num-1))]}"
                    else
                        print_status "ERROR" "Invalid selection"
                    fi
                fi
                ;;
            3)
                if [ $vm_count -gt 0 ]; then
                    read -p "$(print_status "INPUT" "VM number to stop: ")" vm_num
                    if [[ "$vm_num" =~ ^[0-9]+$ ]] && [ "$vm_num" -ge 1 ] && [ "$vm_num" -le $vm_count ]; then
                        stop_vm "${vms[$((vm_num-1))]}"
                    else
                        print_status "ERROR" "Invalid selection"
                    fi
                fi
                ;;
            4)
                if [ $vm_count -gt 0 ]; then
                    read -p "$(print_status "INPUT" "VM number for info: ")" vm_num
                    if [[ "$vm_num" =~ ^[0-9]+$ ]] && [ "$vm_num" -ge 1 ] && [ "$vm_num" -le $vm_count ]; then
                        show_vm_info "${vms[$((vm_num-1))]}"
                    else
                        print_status "ERROR" "Invalid selection"
                    fi
                fi
                ;;
            5)
                if [ $vm_count -gt 0 ]; then
                    read -p "$(print_status "INPUT" "VM number to edit: ")" vm_num
                    if [[ "$vm_num" =~ ^[0-9]+$ ]] && [ "$vm_num" -ge 1 ] && [ "$vm_num" -le $vm_count ]; then
                        edit_vm_config "${vms[$((vm_num-1))]}"
                    else
                        print_status "ERROR" "Invalid selection"
                    fi
                fi
                ;;
            6)
                if [ $vm_count -gt 0 ]; then
                    read -p "$(print_status "INPUT" "VM number to delete: ")" vm_num
                    if [[ "$vm_num" =~ ^[0-9]+$ ]] && [ "$vm_num" -ge 1 ] && [ "$vm_num" -le $vm_count ]; then
                        delete_vm "${vms[$((vm_num-1))]}"
                    else
                        print_status "ERROR" "Invalid selection"
                    fi
                fi
                ;;
            7)
                if [ $vm_count -gt 0 ]; then
                    read -p "$(print_status "INPUT" "VM number to resize: ")" vm_num
                    if [[ "$vm_num" =~ ^[0-9]+$ ]] && [ "$vm_num" -ge 1 ] && [ "$vm_num" -le $vm_count ]; then
                        resize_vm_disk "${vms[$((vm_num-1))]}"
                    else
                        print_status "ERROR" "Invalid selection"
                    fi
                fi
                ;;
            8)
                if [ $vm_count -gt 0 ]; then
                    read -p "$(print_status "INPUT" "VM number for performance: ")" vm_num
                    if [[ "$vm_num" =~ ^[0-9]+$ ]] && [ "$vm_num" -ge 1 ] && [ "$vm_num" -le $vm_count ]; then
                        show_vm_performance "${vms[$((vm_num-1))]}"
                    else
                        print_status "ERROR" "Invalid selection"
                    fi
                fi
                ;;
            0)
                echo
                print_status "SYSTEM" "Shutting down Multi-VM Manager..."
                echo -e "${BOLD}${BPURPLE}          See you in the next session, warrior.${RESET}"
                echo
                exit 0
                ;;
            *)
                print_status "ERROR" "Invalid option"
                ;;
        esac

        read -p "$(print_status "INPUT" "Press Enter to return to menu...")"
    done
}

